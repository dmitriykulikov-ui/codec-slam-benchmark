FROM ubuntu:22.04
# Basalt prebuilt release 0.1.7 (latest release on the build date of the paper image, 2026-10-07).
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i "s|http://archive.ubuntu.com|http://mirror.yandex.ru|g; s|http://security.ubuntu.com|http://mirror.yandex.ru|g" /etc/apt/sources.list && echo "Acquire::Retries \"8\";" > /etc/apt/apt.conf.d/80retries
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates sudo xz-utils tar && rm -rf /var/lib/apt/lists/*
RUN curl -LsSf https://gitlab.com/VladyslavUsenko/basalt/-/raw/master/scripts/install.sh -o /tmp/install.sh && sh /tmp/install.sh 0.1.7
ENV PATH=/root/.local/bin:$PATH LD_LIBRARY_PATH=/root/.local/lib
RUN ls /root/.local/bin && ls /root/.local/etc/basalt | grep -i tumvi && (ldd /root/.local/bin/basalt_vio | grep "not found" || true)
