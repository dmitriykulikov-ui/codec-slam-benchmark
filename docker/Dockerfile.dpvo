FROM nvidia/cuda:12.8.1-devel-ubuntu22.04
# Build for your GPU, e.g. --build-arg TORCH_CUDA_ARCH_LIST="8.6" (the paper used 12.0, RTX 5060 Ti)
ARG TORCH_CUDA_ARCH_LIST="12.0"
ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1 TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} MAX_JOBS=8
RUN sed -i "s|http://archive.ubuntu.com|http://mirror.yandex.ru|g; s|http://security.ubuntu.com|http://mirror.yandex.ru|g" /etc/apt/sources.list && echo 'Acquire::Retries "8";' > /etc/apt/apt.conf.d/80retries
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-dev git wget unzip ninja-build libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/* && ln -sf /usr/bin/python3 /usr/bin/python
RUN pip install --upgrade pip setuptools wheel && pip install torch==2.7.1 torchvision==0.22.1 --index-url https://download.pytorch.org/whl/cu128
RUN pip install "numpy<2.3" opencv-python-headless scipy tqdm einops numba plyfile evo yacs pyyaml matplotlib
RUN pip install torch-scatter -f https://data.pyg.org/whl/torch-2.7.0+cu128.html || pip install --no-build-isolation torch-scatter
RUN git clone --recursive https://github.com/princeton-vl/DPVO.git /opt/DPVO && cd /opt/DPVO && \
    git checkout 0ac95b656d1fda91c271d2a106460d19ad966fc7 && git submodule update --init --recursive && git rev-parse HEAD > COMMIT && \
    wget -q https://gitlab.com/libeigen/eigen/-/archive/3.4.0/eigen-3.4.0.zip && unzip -q eigen-3.4.0.zip -d thirdparty && rm eigen-3.4.0.zip && \
    grep -rlE '\.type\(\)' --include=*.cu --include=*.cpp --include=*.h dpvo | xargs -r sed -i -E 's/([A-Za-z0-9_]+)\.type\(\)/\1.scalar_type()/g' && \
    pip install --no-build-isolation .
RUN cd /opt/DPVO && U=$(grep -oE 'https?://[^ "]+models\.zip[^ "]*' download_models_and_data.sh | head -1) && echo "model url: $U" && \
    wget -q -O models.zip "$U" && unzip -q -o models.zip && rm models.zip && ls -la *.pth
WORKDIR /opt/DPVO
